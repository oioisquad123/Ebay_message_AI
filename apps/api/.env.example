# V0 routes through OpenRouter via the OpenAI-compatible Chat Completions API.
# Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=sk-or-v1-...

# Default model. Pre-selected for cheapest-good-enough on the V0 paste-and-draft loop:
#   ~0.5¢/draft at V0 token sizes, preserves Claude family per PRD §14.3, JSON-output reliable.
# Override only if you want to trade fidelity for cost or test alternatives.
OPENROUTER_MODEL=anthropic/claude-haiku-4-5

# Optional self-identifying headers — show up in your OpenRouter usage dashboard.
OPENROUTER_REFERER=https://github.com/bayuhidayat/ebay-msg-ai
OPENROUTER_TITLE=eBay AI Message Assistant V0

# Local SQLite. Created on first boot.
SQLITE_PATH=./data/v0.db

# Fastify port.
PORT=3000
