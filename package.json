{
  "name": "ebay-msg-ai",
  "version": "0.0.1",
  "private": true,
  "description": "eBay AI Message Assistant — V0 (personal tool of one) → V1 (closed-beta SaaS)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "pnpm --filter @app/api dev",
    "dev:ui": "pnpm --filter @app/dashboard dev",
    "dev": "pnpm run --parallel \"/^dev:.*/\"",
    "eval": "pnpm --filter @tools/eval-runner eval"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
